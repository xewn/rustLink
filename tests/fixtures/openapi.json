  "components": {
    "schemas": {
      "AIConfig": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "是否启用AI助手",
            "default": false
          },
          "api_url": {
            "type": "string",
            "title": "Api Url",
            "description": "AI API地址",
            "default": "https://api.openai.com/v1"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key",
            "description": "AI API Key",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "模型名称",
            "default": "gpt-3.5-turbo"
          }
        },
        "type": "object",
        "title": "AIConfig",
        "description": "AI配置"
      },
      "AIParseRequest": {
        "properties": {
          "input": {
            "type": "string",
            "title": "Input",
            "description": "用户的自然语言描述"
          },
          "api_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Url",
            "description": "AI API地址"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key",
            "description": "AI API Key"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "模型名称"
          }
        },
        "type": "object",
        "required": [
          "input"
        ],
        "title": "AIParseRequest",
        "description": "AI解析请求"
      },
      "Body_import_excel_api_devices_import_excel_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_excel_api_devices_import_excel_post"
      },
      "DeviceConfig": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "设备ID"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "设备名称"
          },
          "protocol": {
            "type": "string",
            "title": "Protocol",
            "description": "协议类型: modbus_tcp/modbus_rtu/s7/mitsubishi"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "是否启用",
            "default": true
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip",
            "description": "IP地址"
          },
          "port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Port",
            "description": "端口号(TCP)或串口号(RTU)"
          },
          "com_port": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Com Port",
            "description": "串口号"
          },
          "baudrate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baudrate",
            "description": "波特率"
          },
          "parity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parity",
            "description": "校验位",
            "default": "N"
          },
          "databits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Databits",
            "description": "数据位",
            "default": 8
          },
          "stopbits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopbits",
            "description": "停止位",
            "default": 1
          },
          "slave_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slave Id",
            "description": "从站ID",
            "default": 1
          },
          "rack": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rack",
            "description": "机架号",
            "default": 0
          },
          "slot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot",
            "description": "插槽号",
            "default": 1
          },
          "plc_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plc Type",
            "description": "PLC型号"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/PointConfig"
            },
            "type": "array",
            "title": "Points",
            "description": "点位列表"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "protocol"
        ],
        "title": "DeviceConfig",
        "description": "设备配置"
      },
      "GatewayConfig": {
        "properties": {
          "gateway_name": {
            "type": "string",
            "title": "Gateway Name",
            "description": "网关名称",
            "default": "默认网关"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceConfig"
            },
            "type": "array",
            "title": "Devices",
            "description": "设备列表"
          },
          "mqtt": {
            "$ref": "#/components/schemas/MqttConfig"
          },
          "collect_interval": {
            "type": "integer",
            "title": "Collect Interval",
            "description": "采集间隔（毫秒）",
            "default": 1000
          },
          "reconnect": {
            "$ref": "#/components/schemas/ReconnectConfig"
          }
        },
        "type": "object",
        "title": "GatewayConfig",
        "description": "网关完整配置"
